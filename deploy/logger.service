# systemd unit for the logger service.
# Install: sudo cp deploy/logger.service /etc/systemd/system/logger.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now logger
[Unit]
Description=Laravel site logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=logger
WorkingDirectory=/opt/logger
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/logger/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
