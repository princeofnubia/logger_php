# --- Server ---
PORT=4000
# Keep 127.0.0.1 when running behind nginx (recommended).
HOST=127.0.0.1
DB_PATH=data/logger.db
# Public URL of the dashboard, used for links in alert emails.
DASHBOARD_URL=https://logs.example.com

# --- Security ---
# Shared secret your Laravel app and the metrics agent send. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Uptime checks (comma-separated) ---
UPTIME_URLS=https://example.com,https://example.com/up
UPTIME_INTERVAL_SECONDS=60
UPTIME_TIMEOUT_MS=10000
# Consecutive failures before a DOWN email is sent.
UPTIME_FAILURES_BEFORE_ALERT=2

# --- Email alerts ---
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=Site Monitor <alerts@example.com>
ALERT_SUBJECT_PREFIX=[Site Monitor]
# The same error / threshold alert is sent at most once per this many minutes.
ALERT_COOLDOWN_MINUTES=30
# Log levels that trigger an email.
ALERT_LEVELS=error,critical,alert,emergency
ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
# Alert when a droplet's metrics agent goes quiet for this long.
ALERT_METRICS_SILENCE_MINUTES=5

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465, false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Retention (days) ---
RETENTION_LOGS_DAYS=30
RETENTION_REQUESTS_DAYS=14
RETENTION_METRICS_DAYS=14
RETENTION_UPTIME_DAYS=30
